server <- function(input, output) {
  output$map3 <- renderHighchart({
    highcharter::highchart(type = "map") |> 
      hc_add_custom_map(data = test_data, joinBy = "fips", value = "value", mapType = "c") |>
      highcharter::hc_colorAxis(min = 4600)
  })
  
  output$map4 <- renderHighchart({
    highcharter::highchart(type = "map") |> 
      hc_add_custom_map(data = test_data, joinBy = "fips", value = "value", mapType = "a") |>
      highcharter::hc_colorAxis(min = 4600)
  })
  
  output$map <- renderHighchart({
    highcharter::highchart(type = "map") |> 
      hc_add_custom_map(data = test_data, joinBy = "fips", value = "value", mapType = "b") |>
      highcharter::hc_colorAxis(min = 4600)
  })
  
  
  output$map2 <- renderHighchart({
    data <- test_data
    data$categories <- sample(LETTERS[1:3], nrow(data), replace = TRUE)
    
    highcharter::highchart(type = "map") |> 
      hc_add_custom_map_cat(data = data, joinBy = "fips", value = "categories") |>
      highcharter::hc_colorAxis(
        dataClasses = list(
          list(
            from = "A",
            to = "A",
            name = "A"
          ),
          list(
            from = "B",
            to = "B",
            name = "B"
          ),
          list(
            from = "C",
            to = "C",
            name = "C"
          )
        )
      )
  })
}

shinyApp(ui, server, options = list(port = 3030L))

library(dplyr)

m <- jsonlite::read_json("inst/mapdata.json")
m2 <- jsonlite::read_json("inst/mapdata2.json")
m3 <- jsonlite::read_json("inst/mapdata3.json")
m4 <- jsonlite::read_json("inst/mapdata4.json")

us_map <- m[[1]]$mapData
us_map <- purrr::map2(us_map, m2[[1]]$mapData, \(m1, m2) {
  m1$fips <- as.numeric(m1$fips)
  m1$path <- m2$path
  return(m1)
})
us_map2 <- m3[[1]]$mapData
us_map2 <- purrr::map(us_map2, \(m) {
  m$fips <- as.numeric(m$fips)
  return(m)
})
us_map3 <- m4[[1]]$mapData
us_map3 <- purrr::map(us_map3, \(m3) {
  m3$id <- m3$id |>
    (\(.) gsub("id", "", .))() |>
    as.integer() |>
    (\(.) . - 1)() |>
    (\(.) paste0("id", .))()
  
  cn <- us_map |>
    purrr::keep(\(x) {
      x$id == m3$id
    })
  
  if(length(cn) == 0){
    cat("Could not find:", m3$id, "\n")
    return(m3)
  }
  
  m3$fips <- as.numeric(cn[[1]]$fips)
  m3$name <- cn[[1]]$name
  return(m3)
})

separators <- m2[[2]]$mapData
separators2 <- m4[[2]]$mapData

test_data <- us_map |>
  purrr::map_dfr(as.data.frame) |>
  select(id, name, fips) |>
  mutate(
    value = 1e5 * abs(rt(n(), df = 10))
  )

usethis::use_data(us_map, us_map2, us_map3, separators, separators2, overwrite = TRUE, internal = TRUE)
usethis::use_data(test_data, overwrite = TRUE)


